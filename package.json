{
  "name": "nacre-cli",
  "version": "0.9.0",
  "description": "One shared memory for your whole company — plain Markdown in git that your agent loads at session start and your team reads in a browser.",
  "keywords": [
    "ai-memory",
    "agent-memory",
    "team-memory",
    "context",
    "claude",
    "claude-code",
    "markdown",
    "git",
    "monorepo",
    "cross-repo"
  ],
  "homepage": "https://github.com/rambaarde/nacre#readme",
  "bugs": {
    "url": "https://github.com/rambaarde/nacre/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rambaarde/nacre.git"
  },
  "license": "Apache-2.0",
  "author": "rambaarde",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "nacre": "dist/bin/nacre.js",
    "nac": "dist/bin/nacre.js"
  },
  "files": [
    "dist/bin",
    "dist/src",
    "!dist/**/*.map",
    "!dist/**/*.d.ts",
    "skills",
    "store-template",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2"
  },
  "types": "dist/src/operations.d.ts"
}
